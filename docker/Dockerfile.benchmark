# Inference Benchmarks - GPU Environment (Updated for TRT-LLM v0.21+)
# Self-contained benchmark environment for any NVIDIA GPU host.

FROM nvcr.io/nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHON_VERSION=3.10
ENV PATH="/root/miniconda3/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-venv python3-pip python3.10-dev \
    git git-lfs wget curl jq \
    && rm -rf /var/lib/apt/lists/*

# Install TensorRT-LLM v0.21+ (includes trtllm-bench, trtllm-build, trtllm-serve)
RUN pip install --no-cache-dir tensorrt-llm>=0.21.0 \
    --extra-index-url https://pypi.nvidia.com

# Install benchmark dependencies
RUN pip install --no-cache-dir \
    pyyaml matplotlib numpy pandas requests aiohttp

# Install GenAI-Perf for NIM benchmarking
RUN pip install --no-cache-dir genai-perf || true

# Verify installation
RUN trtllm-bench --help 2>/dev/null || echo "trtllm-bench not found in PATH"

# Create workspace
WORKDIR /workspace
COPY . /workspace/

# Default: show help
CMD ["python3", "scripts/run_benchmarks.py", "--help"]
