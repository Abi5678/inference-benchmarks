# Inference Benchmarks - GPU Environment
# Use this Dockerfile for a self-contained benchmark environment on any NVIDIA GPU host.

FROM nvcr.io/nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHON_VERSION=3.10
ENV PATH="/root/miniconda3/bin:${PATH}"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-venv python3-pip \
    git wget curl \
    && rm -rf /var/lib/apt/lists/*

# Install TensorRT-LLM
RUN pip install --no-cache-dir tensorrt-llm \
    --extra-index-url https://pypi.nvidia.com

# Install benchmark tools
RUN pip install --no-cache-dir \
    pyyaml matplotlib numpy requests \
    locust k6

# Install trtllm-bench
RUN trtllm-bench --help || true

# Create workspace
WORKDIR /workspace
COPY . /workspace/

# Default: run full benchmark suite
CMD ["python3", "scripts/run_benchmarks.py", "--phase", "all"]
